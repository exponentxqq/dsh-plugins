{
  "name": "dsh-plugins",
  "version": "1.1.0",
  "private": true,
  "description": "DSH（DeepSeek Harness）自定义插件单仓：以 pnpm workspace 统一管理 plugins/* 下的官方组合包（bundle）插件",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "volta": {
    "node": "22.18.0",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "docs:check": "pnpm -r run docs:check",
    "release": "node scripts/release.mjs",
    "verify": "pnpm -r run verify:all"
  }
}
