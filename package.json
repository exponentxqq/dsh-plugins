{
  "name": "dsh-plugins",
  "version": "1.5.0",
  "private": true,
  "description": "DSH（DeepSeek Harness）自定义插件单仓：以 pnpm workspace 统一管理 plugins/* 下的官方组合包（bundle）插件",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "volta": {
    "node": "24.21.0",
    "pnpm": "11.25.0"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.16.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "docs:check": "node scripts/check-docs.mjs && pnpm -r run docs:check",
    "spec:check": "openspec validate --all --strict",
    "gen:plugin": "node scripts/gen-plugin.mjs",
    "release": "node scripts/release.mjs",
    "dsh:upgrade": "node scripts/upgrade-dsh.mjs",
    "dsh:check": "node scripts/dsh-check.mjs",
    "verify": "pnpm -r run verify:all"
  }
}
