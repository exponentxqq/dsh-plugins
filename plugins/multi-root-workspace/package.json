    "@deepseek-ai/dsh-file-reference": "catalog:dsh",
    "@deepseek-ai/dsh-file-reference-local": "catalog:dsh",
    "@deepseek-ai/dsh-subprocess-local": "catalog:dsh"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.2-rc.1 <0.3.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "dependencies": {
    "zod": "4.4.3",
    "@deepseek-ai/node-addon-system": "^0.1.2",
    "koffi": "^3.1.0"
  }
}
