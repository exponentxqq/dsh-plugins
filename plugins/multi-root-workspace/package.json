{
  "name": "dsh-plugin-multi-root-workspace",
  "description": "Multi-root Workspace for DeepSeek Harness: adds N additional roots to the workspace sandbox scope as an out-of-tree bundle",
  "version": "1.5.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./compat": {
      "types": "./lib/types/compat.d.ts",
      "default": "./lib/compat.js"
    },
    "./fs": {
      "types": "./lib/types/fs.d.ts",
      "default": "./lib/fs.js"
    },
    "./sandbox": {
      "types": "./lib/types/sandbox.d.ts",
      "default": "./lib/sandbox.js"
    },
    "./scope": {
      "types": "./lib/types/scope.d.ts",
      "default": "./lib/scope.js"
    },
    "./registry": {
      "types": "./lib/types/registry.d.ts",
      "default": "./lib/registry.js"
    },
    "./instructions": {
      "types": "./lib/types/instructions.d.ts",
      "default": "./lib/instructions.js"
    },
    "./command": {
      "types": "./lib/types/command.d.ts",
      "default": "./lib/command.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./lsp": {
      "types": "./lib/types/lsp.d.ts",
      "default": "./lib/lsp.js"
    },
    "./workspace-files": {
      "types": "./lib/types/workspace-files.d.ts",
      "default": "./lib/workspace-files.js"
    },
    "./file-references": {
      "types": "./lib/types/file-references.d.ts",
      "default": "./lib/file-references.js"
    },
    "./windows-runner": {
      "types": "./lib/types/windows-runner.d.ts",
      "default": "./lib/windows-runner.js"
    }
  },
  "files": [
    "lib/*.js",
    "lib/*.js.map",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm run build:types && pnpm run bundle",
    "build:types": "tsc -p tsconfig.host.json && tsc -p tsconfig.client.json",
    "bundle": "node scripts/clean-lib.mjs && tsdown",
    "compat:check": "node scripts/check-dsh-compat.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "kernel:probe": "node scripts/check-kernel-runner.mjs",
    "lint": "oxlint",
    "smoke": "pnpm smoke:compose && pnpm smoke:behavior && pnpm smoke:journey",
    "smoke:behavior": "node scripts/smoke-behavior.mjs",
    "smoke:compose": "node scripts/smoke-compose.mjs",
    "smoke:journey": "node scripts/smoke-journey.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "verify:all": "pnpm lint && pnpm compat:check && pnpm typecheck && pnpm build && pnpm kernel:probe && pnpm test && pnpm smoke",
    "prepack": "pnpm run build"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5.0.0",
    "@deepseek-ai/dsh": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-agent-instructions": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-connection": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-commands": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-fs": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-fs-local": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-sandbox": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-sandbox-local": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-subprocess": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-lsp": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-lsp-stdio": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-api-workspace-files": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-sandbox-windows-acl": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-file-reference": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-file-reference-local": ">=0.2.2-rc.1 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-instructions": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-subprocess": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-lsp": {
      "optional": true
    },
    "@deepseek-ai/dsh-lsp-stdio": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-workspace-files": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox-windows-acl": {
