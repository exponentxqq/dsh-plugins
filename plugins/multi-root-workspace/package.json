  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:dsh",
    "@deepseek-ai/dsh": "catalog:dsh",
    "@deepseek-ai/dsh-agent": "catalog:dsh",
    "@deepseek-ai/dsh-agent-instructions": "catalog:dsh",
    "@deepseek-ai/dsh-app-boot": "catalog:dsh",
    "@deepseek-ai/dsh-base": "catalog:dsh",
    "@deepseek-ai/dsh-client-connection": "catalog:dsh",
    "@deepseek-ai/dsh-client-locale": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-primitives": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-renderer": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-workspace": "catalog:dsh",
    "@deepseek-ai/dsh-commands": "catalog:dsh",
    "@deepseek-ai/dsh-fs": "catalog:dsh",
    "@deepseek-ai/dsh-fs-local": "catalog:dsh",
    "@deepseek-ai/dsh-fs-sandbox": "catalog:dsh",
    "@deepseek-ai/dsh-llm": "catalog:dsh",
    "@deepseek-ai/dsh-sandbox": "catalog:dsh",
    "@deepseek-ai/dsh-sandbox-local": "catalog:dsh",
    "@deepseek-ai/dsh-sandbox-policy": "catalog:dsh",
    "@deepseek-ai/dsh-session": "catalog:dsh",
    "@deepseek-ai/dsh-session-projection": "catalog:dsh",
    "@deepseek-ai/dsh-storage": "catalog:dsh",
    "@deepseek-ai/dsh-storage-domain": "catalog:dsh",
    "@deepseek-ai/dsh-storage-json": "catalog:dsh",
    "@deepseek-ai/dsh-subprocess": "catalog:dsh",
    "@deepseek-ai/dsh-system-prompt": "catalog:dsh",
    "@deepseek-ai/dsh-workspace": "catalog:dsh",
    "@dsh-plugins/client-kit": "workspace:*",
    "@dsh-plugins/contracts": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.31",
    "@types/react-dom": "catalog:",
    "clsx": "^2.0.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.76.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "vite": "8.3.0",
    "vitest": "^4.1.8",
    "yaml": "^2.9.0",
    "@deepseek-ai/dsh-lsp": "catalog:dsh",
    "@deepseek-ai/dsh-lsp-stdio": "catalog:dsh",
    "@deepseek-ai/dsh-api-workspace-files": "catalog:dsh",
    "@deepseek-ai/dsh-typert-protocol": "catalog:dsh",
