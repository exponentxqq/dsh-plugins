{
  "name": "dsh-plugin-web-ux",
  "description": "External dsh web GUI plugin: model-provider badge in the composer status row plus irreversible deletion of archived sessions from the sidebar (dual-half: host RPC channel + browser entries; project-level MCP support lives in the standalone dsh-plugin-project-mcp)",
  "version": "1.2.0",
  "icon": "icon.svg",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2 <0.3.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/**/*.js",
    "src",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-session-persistence": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-workspace": ">=0.2.1-rc.2 <0.3.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-session-persistence": {
      "optional": true
    },
    "@deepseek-ai/dsh-workspace": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-model-selection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.1-rc.2",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.5",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "oxlint": "^1.42.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "verify:all": "pnpm lint && pnpm typecheck && pnpm build && pnpm test",
    "prepack": "pnpm run build"
  }
}
