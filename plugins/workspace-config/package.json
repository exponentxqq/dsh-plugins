{
  "name": "dsh-plugin-workspace-config",
  "description": "DSH Web GUI 的统一「工作区配置」入口（holder，零业务逻辑）：侧栏面板行（sidebar.panellist）+ 主区域独立页面（main 注册，两侧共用同一面板 id），页面级统一工作区选择框与分节座位 workspace-config.section；其他插件以纯类型依赖方式贡献分节",
  "version": "1.5.0",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.2-rc.1 <0.3.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "src",
    "cordis.patch.yml"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.2-rc.1 <0.3.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:dsh",
    "@deepseek-ai/dsh": "catalog:dsh",
    "@deepseek-ai/dsh-api-session-controller": "catalog:dsh",
    "@deepseek-ai/dsh-api-workspace-controller": "catalog:dsh",
    "@deepseek-ai/dsh-client-locale": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-layout": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-primitives": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-renderer": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-sidebar": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:dsh",
    "@dsh-plugins/build-kit": "workspace:*",
    "@dsh-plugins/client-kit": "workspace:*",
    "@dsh-plugins/contracts": "workspace:*",
    "@dsh-plugins/test-kit": "workspace:*",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "oxlint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "build": "pnpm run build:types && node build.mjs",
    "build:types": "tsc -p tsconfig.host.json && tsc -p tsconfig.client.json",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.host.json --pretty false && tsc -p tsconfig.client.json --pretty false",
    "verify:all": "pnpm lint && pnpm typecheck && pnpm build && pnpm test",
    "prepack": "pnpm run build"
  }
}
