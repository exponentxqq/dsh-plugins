{
  "name": "dsh-plugin-user-commands",
  "description": "External dsh plugin (host-only, any profile): user-defined slash commands from markdown files — three layers (builtin / $DSH_HOME/commands / each workspace root's .dsh/commands), per-session shadowing, live refresh, and a builtin /init",
  "version": "1.3.0",
  "icon": "icon.svg",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    }
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2 <0.3.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/**/*.js",
    "src",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dependencies": {
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.1-rc.2",
    "@types/node": "^22.20.0",
    "esbuild": "^0.25.0",
    "oxlint": "^1.42.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "verify:all": "pnpm lint && pnpm typecheck && pnpm build && pnpm test",
    "prepack": "pnpm run build"
  }
}
