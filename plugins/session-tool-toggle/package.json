{
  "name": "dsh-plugin-session-tool-toggle",
  "description": "DSH 插件（双端）：会话级工具面开关——按 mcp:<server> 整组 / 单工具与 tool:<name> 内置工具在会话内关闭，命令面 /tools 与 Web 会话头部面板共用同一状态（宿主半承载 Connection RPC 通道 /session-tool-toggle）",
  "version": "1.5.0",
  "icon": "icon.svg",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.2-rc.1 <0.3.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-commands"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/**/*.js",
    "src",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.2-rc.1 <0.3.0",
    "react": "^18.2.0"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:dsh",
    "@deepseek-ai/dsh-agent": "catalog:dsh",
    "@deepseek-ai/dsh-atomic-write": "catalog:dsh",
    "@deepseek-ai/dsh-client-connection": "catalog:dsh",
    "@deepseek-ai/dsh-client-locale": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-commands": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-conversation": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-primitives": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-renderer": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-session": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:dsh",
    "@deepseek-ai/dsh-commands": "catalog:dsh",
    "@deepseek-ai/dsh-home-paths": "catalog:dsh",
    "@deepseek-ai/dsh-session": "catalog:dsh",
    "@deepseek-ai/dsh-session-projection": "catalog:dsh",
    "@deepseek-ai/dsh-tools": "catalog:dsh",
    "@deepseek-ai/schemastery": "catalog:dsh",
    "@dsh-plugins/build-kit": "workspace:*",
    "@dsh-plugins/contracts": "workspace:*",
    "@dsh-plugins/host-kit": "workspace:*",
    "@dsh-plugins/test-kit": "workspace:*",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "oxlint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "build": "node build.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.host.json --pretty false && tsc -p tsconfig.client.json --pretty false",
    "verify:all": "pnpm lint && pnpm typecheck && pnpm build && pnpm test",
    "prepack": "pnpm run build"
  }
}
