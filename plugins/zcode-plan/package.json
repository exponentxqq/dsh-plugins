{
  "name": "dsh-plugin-zcode-plan",
  "description": "DSH 插件（host-only，任意 profile）：zcode 计划桥接——复用宿主 zcode 凭证（PAT）维持登录态、把 /zcode-plan 计划命令接入会话；organization / project 必须显式配置",
  "version": "1.6.0",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.2-rc.1 <0.3.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/**/*.js",
    "src",
    "cordis.patch.yml"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:dsh",
    "@deepseek-ai/dsh": "catalog:dsh",
    "@deepseek-ai/dsh-authorization": "catalog:dsh",
    "@deepseek-ai/dsh-credentials": "catalog:dsh",
    "@deepseek-ai/schemastery": "catalog:dsh",
    "@dsh-plugins/build-kit": "workspace:*",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "build": "node build.mjs",
    "compose:check": "node scripts/compose-check.mjs",
    "discount:snap": "node scripts/refresh-snap.mjs",
    "discount:verify": "bash scripts/verify-discount.sh",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.host.json --pretty false",
    "verify:all": "pnpm lint && pnpm typecheck && pnpm build && pnpm test",
    "prepack": "pnpm run build"
  }
}
